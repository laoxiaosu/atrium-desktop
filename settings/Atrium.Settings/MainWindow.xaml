<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Atrium.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Atrium.Settings"
    Title="Atrium 设置">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <!-- Three columns (DESIGN.md §8): the sidebar on the window's material; the workspace (live preview,
         the page's main choices) scrolling on its own; the inspector (the page's other parameters) on the right,
         scrolling on its own. A narrow window folds the inspector under the workspace (OnContentSizeChanged). -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Both scrolling columns start below this fixed title bar. -->
        <Border Grid.ColumnSpan="2" Background="{ThemeResource PageBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="144" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="AppTitleBar" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="22,0,0,0" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/atrium-256.png" Width="26" Height="26" />
                        <TextBlock Text="Atrium" FontFamily="{StaticResource TitleFont}" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <!-- Outside the draggable element, so both actions receive normal pointer input. -->
                <Border x:Name="SaveBar" Grid.Column="1" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse x:Name="DirtyDot" Width="6" Height="6" VerticalAlignment="Center" Fill="#FFFF9F0A" />
                        <TextBlock x:Name="DirtyText" Text="未保存" FontSize="13" VerticalAlignment="Center" />
                        <Button x:Name="RevertButton" Content="撤销" AutomationProperties.Name="撤销修改" Click="OnRevert" IsEnabled="False" />
                        <Button x:Name="SaveButton" Content="保存" Click="OnSave" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Sidebar ============ -->
        <Grid Grid.Row="1" Padding="12,16,12,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView x:Name="Nav" SelectionMode="Single" SelectionChanged="OnNavChanged"
                      AutomationProperties.Name="导航" VerticalAlignment="Top" ItemContainerStyle="{StaticResource NavItemStyle}">
                <ListViewItem AutomationProperties.Name="材质"><local:NavLabel Glyph="&#xE790;" Text="材质" /></ListViewItem>
                <ListViewItem AutomationProperties.Name="形状"><local:NavLabel Glyph="&#xE7C9;" Text="形状" /></ListViewItem>
                <ListViewItem AutomationProperties.Name="任务栏"><local:NavLabel Glyph="&#xE718;" Text="任务栏" /></ListViewItem>
                <ListViewItem AutomationProperties.Name="通知"><local:NavLabel Glyph="&#xEA8F;" Text="通知" /></ListViewItem>
                <ListViewItem AutomationProperties.Name="小组件"><local:NavLabel Glyph="&#xE8A9;" Text="小组件" /></ListViewItem>
                <ListViewItem AutomationProperties.Name="台前调度"><local:NavLabel Glyph="&#xE7C4;" Text="台前调度" /></ListViewItem>
                <ListViewItem AutomationProperties.Name="系统"><local:NavLabel Glyph="&#xE770;" Text="系统" /></ListViewItem>
                <ListViewItem AutomationProperties.Name="设计语言" Margin="0,18,0,2"><local:NavLabel Glyph="&#xE8D2;" Text="设计语言" /></ListViewItem>
                <ListViewItem AutomationProperties.Name="关于"><local:NavLabel Glyph="&#xE946;" Text="关于" /></ListViewItem>
            </ListView>

            <StackPanel Grid.Row="1" Spacing="4" Margin="10,0,6,0">
                <Button x:Name="UpdateAvailableButton" Content="有可用更新" Visibility="Collapsed"
                        HorizontalAlignment="Stretch" Margin="0,0,0,12"
                        Style="{StaticResource PrimaryButtonStyle}" Click="OnOpenUpdate"
                        AutomationProperties.Name="有可用更新，查看更新" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusTitle" Grid.Column="1" Text="Atrium" FontSize="13"
                               FontFamily="{StaticResource EmphasisFont}" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="CoreSwitch" Grid.Column="2" Style="{StaticResource SwitchStyle}"
                                  AutomationProperties.Name="Atrium" Toggled="OnCoreToggled" IsEnabled="False" />
                </Grid>
                <TextBlock x:Name="StatusMessage" Style="{StaticResource FootnoteStyle}" Margin="16,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- ============ Workspace + inspector ============ -->
        <Grid x:Name="ContentGrid" Grid.Row="1" Grid.Column="1" Background="{ThemeResource PageBrush}" SizeChanged="OnContentSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ======== Workspace ======== -->
            <ScrollViewer x:Name="CenterScroll" Style="{StaticResource PageStyle}" SizeChanged="OnWorkspaceSizeChanged">
                <StackPanel x:Name="CenterStack" Style="{StaticResource WorkspaceStackStyle}" SizeChanged="OnCenterSizeChanged">
                    <!-- The page's title, at the top of the page (not in the window's title bar) -->
                    <TextBlock x:Name="PageTitle" Style="{StaticResource LargeTitleStyle}" Margin="2,2,0,-4" />
                    <!-- The live preview: the glass bar over the photo (material, shape, dock) -->
                    <StackPanel x:Name="HeroBlock" Spacing="10">
                        <Border x:Name="HeroFrame" Height="360" CornerRadius="28" Background="#FFCBD3DD" SizeChanged="OnHeroSizeChanged">
                            <Grid>
                                <Canvas x:Name="HeroCanvas" />
                                <Border x:Name="Loupe" Width="232" Height="148" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,16,16,0" CornerRadius="16" BorderThickness="2" BorderBrush="#B3FFFFFF" Background="#FFCBD3DD">
                                    <Grid>
                                        <Canvas x:Name="LoupeCanvas" />
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" CornerRadius="6" Padding="6,2,6,3" Background="#80000000">
                                            <TextBlock x:Name="LoupeLabel" Text="5× 放大" FontSize="11" Foreground="#E6FFFFFF" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="28" BorderThickness="1" BorderBrush="#1F000000" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:SegmentTrack>
                                    <RadioButton x:Name="BgSpecimen" GroupName="herobg" Content="流线" Tag="flow" Style="{StaticResource SegmentStyle}" Checked="OnHeroBackgroundChecked" />
                                    <RadioButton x:Name="BgPaper" GroupName="herobg" Content="纸张" Tag="paper" Style="{StaticResource SegmentStyle}" Checked="OnHeroBackgroundChecked" />
                                    <RadioButton x:Name="BgGeometry" GroupName="herobg" Content="几何" Tag="geometry" Style="{StaticResource SegmentStyle}" Checked="OnHeroBackgroundChecked" />
                                    <RadioButton x:Name="BgLayers" GroupName="herobg" Content="层叠" Tag="layers" Style="{StaticResource SegmentStyle}" Checked="OnHeroBackgroundChecked" />
                                    <RadioButton x:Name="BgWallpaper" GroupName="herobg" Content="我的壁纸" Tag="wallpaper" Style="{StaticResource SegmentStyle}" Checked="OnHeroBackgroundChecked" />
                                </local:SegmentTrack>
                            <StackPanel x:Name="LoupeToggle" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="局部放大" Style="{StaticResource RowNoteStyle}" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="LoupeSwitch" Style="{StaticResource SwitchStyle}" Toggled="OnLoupeToggled"
                                              AutomationProperties.Name="局部放大" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ==== Material: presets and the basic three ==== -->
                    <StackPanel x:Name="MainMaterial" Spacing="26">
                        <StackPanel>
                            <TextBlock Text="预设" Style="{StaticResource SectionStyle}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="PresetLiquid" GroupName="preset" Style="{StaticResource PresetTileStyle}" Tag="liquid"
                                             AutomationProperties.Name="液态玻璃" Checked="OnPresetChecked">
                                    <StackPanel Spacing="10">
                                        <Border x:Name="SwatchLiquid" Height="76" CornerRadius="14" Background="#FFCBD3DD" />
                                        <TextBlock Text="液态玻璃" Style="{StaticResource RowTitleStyle}" Margin="4,0,4,2" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="PresetFrosted" Grid.Column="1" GroupName="preset" Style="{StaticResource PresetTileStyle}" Tag="frosted"
                                             AutomationProperties.Name="磨砂玻璃" Checked="OnPresetChecked">
                                    <StackPanel Spacing="10">
                                        <Border x:Name="SwatchFrosted" Height="76" CornerRadius="14" Background="#FFCBD3DD" />
                                        <TextBlock Text="磨砂玻璃" Style="{StaticResource RowTitleStyle}" Margin="4,0,4,2" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="PresetCustom" Grid.Column="2" GroupName="preset" Style="{StaticResource PresetTileStyle}" Tag="custom"
                                             AutomationProperties.Name="自定义" Checked="OnPresetChecked">
                                    <StackPanel Spacing="10">
                                        <Border x:Name="SwatchCustom" Height="76" CornerRadius="14" Background="#FFCBD3DD" />
                                        <TextBlock Text="自定义" Style="{StaticResource RowTitleStyle}" Margin="4,0,4,2" />
                                    </StackPanel>
                                </RadioButton>
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <Grid>
                                <TextBlock Text="质感" Style="{StaticResource SectionStyle}" />
                                <Button Style="{StaticResource ResetButtonStyle}" Tag="clarity" Click="OnGroupReset" AutomationProperties.Name="恢复质感的默认值" />
                            </Grid>
                            <local:ResponsiveGrid x:Name="ClarityTiles" MinCellWidth="220" Gap="12" StretchLastRow="True">
                                <!-- The tint, after the sliders (BuildRows puts them first) -->
                                <Border x:Name="TintTile" Style="{StaticResource TileStyle}">
                                    <Grid RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="染色" Style="{StaticResource RowTitleStyle}" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="0" Margin="-4,0,0,0">
                                            <StackPanel x:Name="TintSwatches" Orientation="Horizontal" />
                                            <Button x:Name="TintButton" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" CornerRadius="16"
                                                    AutomationProperties.Name="自定义颜色" ToolTipService.ToolTip="自定义颜色">
                                                <Grid Width="24" Height="24">
                                                    <Ellipse x:Name="TintSwatch" Stroke="{ThemeResource CardStrokeBrush}" StrokeThickness="1" />
                                                    <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="{ThemeResource InkSecondaryBrush}" />
                                                </Grid>
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterStyle="{StaticResource AtriumFlyoutStyle}">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock x:Name="TintHex" Style="{StaticResource ValueStyle}" TextAlignment="Left" />
                                                            <ColorPicker x:Name="TintPicker" IsAlphaEnabled="False" IsMoreButtonVisible="True"
                                                                         ColorChanged="OnTintChanged" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </local:ResponsiveGrid>
                        </StackPanel>
                    </StackPanel>

                    <!-- ==== Shape: the geometry, read out ==== -->
                    <StackPanel x:Name="MainShape" Visibility="Collapsed">
                        <TextBlock Text="几何" Style="{StaticResource SectionStyle}" />
                        <Border Style="{StaticResource TileStyle}" Padding="22,16,22,16">
                            <local:ResponsiveGrid x:Name="ShapeReadout" MinCellWidth="120" Gap="12" />
                        </Border>
                    </StackPanel>

                    <!-- ==== Dock: the pinned apps ==== -->
                    <StackPanel x:Name="MainDock" Visibility="Collapsed">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="固定的应用" Style="{StaticResource SectionStyle}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <TextBlock x:Name="PinCount" Style="{StaticResource FootnoteStyle}" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Typography.NumeralAlignment="Tabular" />
                                <Button x:Name="ImportPinsButton" Content="导入系统任务栏固定项" Click="OnImportPins" />
                                <Button x:Name="AddPinButton" Content="添加应用…" Click="OnAddPin" Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource GroupStyle}">
                            <Grid>
                                <ListView x:Name="PinsList" SelectionMode="None" CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                                          ItemContainerStyle="{StaticResource PinItemStyle}" DragItemsCompleted="OnPinsDragCompleted"
                                          AutomationProperties.Name="固定的应用" Padding="0,4,0,4">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:PinVm">
                                                <Grid Padding="14,8,10,8" ColumnSpacing="14" MinHeight="60" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE76F;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource InkTertiaryBrush}" />
                                                    <Grid Grid.Column="1" Width="40" Height="40" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xECAA;" FontSize="20" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}"
                                                                  Foreground="{ThemeResource InkSecondaryBrush}" />
                                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="36" Height="36" />
                                                    </Grid>
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Title}" Style="{StaticResource RowTitleStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                        <ComboBox SelectedIndex="{x:Bind LaunchMode, Mode=TwoWay}" Width="146" Margin="0,0,8,0"
                                                                  AutomationProperties.Name="{x:Bind LaunchName}">
                                                            <ComboBoxItem Content="打开已有窗口" Margin="0,0,0,4" />
                                                            <ComboBoxItem Content="允许多开" />
                                                        </ComboBox>
                                                        <Button Style="{StaticResource IconButtonStyle}" Click="{x:Bind MoveUp}" IsEnabled="{x:Bind CanUp, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind UpName}" ToolTipService.ToolTip="上移">
                                                            <FontIcon Glyph="&#xE70E;" FontSize="13" />
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonStyle}" Click="{x:Bind MoveDown}" IsEnabled="{x:Bind CanDown, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind DownName}" ToolTipService.ToolTip="下移">
                                                            <FontIcon Glyph="&#xE70D;" FontSize="13" />
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonStyle}" Click="{x:Bind Remove}"
                                                                AutomationProperties.Name="{x:Bind RemoveName}" ToolTipService.ToolTip="移除">
                                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel x:Name="PinsEmpty" Visibility="Collapsed" Padding="24,36,24,36" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="还没有固定的应用" Style="{StaticResource TitleStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="点“添加应用…”选择一个程序，或一键导入 Windows 任务栏上已固定的应用。"
                                               Style="{StaticResource RowNoteStyle}" TextAlignment="Center" MaxWidth="360" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ==== Notifications: the cards as they pop up ==== -->
                    <StackPanel x:Name="MainNotify" Visibility="Collapsed" Spacing="10">
                        <Border x:Name="NotifyStage" Height="340" CornerRadius="28" Background="#FFCBD3DD" SizeChanged="OnNotifyStageSizeChanged">
                            <Grid>
                                <Canvas x:Name="NotifyCards" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Border CornerRadius="28" BorderThickness="1" BorderBrush="#1F000000" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <Grid>
                            <TextBlock x:Name="NotifyCaption" Style="{StaticResource FootnoteStyle}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <Button Content="再弹一次" Click="OnReplayNotify" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- ==== Widgets: the desktop's layout, and the gallery ==== -->
                    <StackPanel x:Name="MainWidgets" Visibility="Collapsed" Spacing="26">
                        <StackPanel Spacing="10">
                            <Border x:Name="WidgetStage" Height="320" CornerRadius="28" Background="#FFCBD3DD" SizeChanged="OnWidgetStageSizeChanged">
                                <Grid>
                                    <Viewbox Stretch="Fill">
                                        <Canvas x:Name="WidgetMap" Width="1" Height="1" />
                                    </Viewbox>
                                    <Border CornerRadius="28" BorderThickness="1" BorderBrush="#1F000000" IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="WidgetMapCaption" Style="{StaticResource FootnoteStyle}" Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="添加小组件" Style="{StaticResource SectionStyle}" />
                                <local:SegmentTrack x:Name="WidgetCategories" HorizontalAlignment="Right" Margin="0,0,0,8">
                                    <RadioButton GroupName="widgetcategory" Content="全部" Tag="全部" Style="{StaticResource SegmentStyle}" Checked="OnWidgetCategoryChecked" IsChecked="True" />
                                    <RadioButton GroupName="widgetcategory" Content="时钟" Tag="时钟" Style="{StaticResource SegmentStyle}" Checked="OnWidgetCategoryChecked" />
                                    <RadioButton GroupName="widgetcategory" Content="天气" Tag="天气" Style="{StaticResource SegmentStyle}" Checked="OnWidgetCategoryChecked" />
                                    <RadioButton GroupName="widgetcategory" Content="日历" Tag="日历" Style="{StaticResource SegmentStyle}" Checked="OnWidgetCategoryChecked" />
                                    <RadioButton GroupName="widgetcategory" Content="效率" Tag="效率" Style="{StaticResource SegmentStyle}" Checked="OnWidgetCategoryChecked" />
                                    <RadioButton GroupName="widgetcategory" Content="照片" Tag="照片" Style="{StaticResource SegmentStyle}" Checked="OnWidgetCategoryChecked" />
                                    <RadioButton GroupName="widgetcategory" Content="系统" Tag="系统" Style="{StaticResource SegmentStyle}" Checked="OnWidgetCategoryChecked" />
                                </local:SegmentTrack>
                            </Grid>
                            <StackPanel x:Name="WidgetGallery" Spacing="18" />
                            <TextBlock x:Name="WidgetHint" Style="{StaticResource FootnoteStyle}" Margin="4,10,0,0"
                                       Text="点按添加到桌面" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ==== Stage Manager: the desktop with its strip, cards that swap when clicked ==== -->
                    <StackPanel x:Name="MainStage" Visibility="Collapsed" Spacing="10">
                        <Border x:Name="StagePreview" Height="380" CornerRadius="28" Background="#FFCBD3DD" SizeChanged="OnStagePreviewSizeChanged">
                            <Grid>
                                <Canvas x:Name="StageCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Border CornerRadius="28" BorderThickness="1" BorderBrush="#1F000000" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <Grid>
                            <TextBlock x:Name="StageCaption" Style="{StaticResource FootnoteStyle}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <Button x:Name="StageReplay" Content="演示切换" Click="OnStageReplay" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- ==== System ==== -->
                    <StackPanel x:Name="MainSystem" Visibility="Collapsed">
                        <TextBlock Text="Windows" Style="{StaticResource SectionStyle}" />
                        <local:ResponsiveGrid MinCellWidth="280" Gap="12" StretchLastRow="True">
                            <local:ToggleTile x:Name="StartupSwitch" Title="开机启动" SwitchName="开机启动" Toggled="OnStartupToggled"
                                              Note="登录 Windows 时启动 Atrium。" />
                            <local:ToggleTile x:Name="HideTaskbarSwitch" Title="隐藏系统任务栏" SwitchName="隐藏系统任务栏" Toggled="OnHideTaskbarToggled"
                                              Note="只留下 Atrium 栏。关闭开关或退出 Atrium 时恢复；Win 键等系统快捷键照常可用。" />
                            <local:ToggleTile x:Name="HideBannersSwitch" Title="隐藏系统通知横幅" SwitchName="隐藏系统通知横幅" Toggled="OnHideBannersToggled"
                                              Note="打开 Windows 的“请勿打扰”；通知照常显示为 Atrium 卡片。关闭开关或退出时恢复。" />
                        </local:ResponsiveGrid>
                    </StackPanel>

                    <!-- ==== Design language: built in code (MainWindow.Design.cs) the first time it is shown ==== -->
                    <StackPanel x:Name="DesignStack" Visibility="Collapsed" Spacing="40" />

                    <!-- ==== About ==== -->
                    <StackPanel x:Name="MainAbout" Visibility="Collapsed" Spacing="28">
                        <Border Style="{StaticResource TileStyle}" Padding="28,28,28,26">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Image Source="ms-appx:///Assets/atrium-256.png" Width="96" Height="96" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Atrium Desktop" Style="{StaticResource LargeTitleStyle}" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource RowNoteStyle}" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Style="{StaticResource RowNoteStyle}" Margin="0,6,0,0"
                                               Text="玻璃任务栏与桌面小组件" />
                                    <HyperlinkButton NavigateUri="https://github.com/wynter-yaxley/atrium-desktop" Padding="0" Margin="0,6,0,0"
                                                     Content="github.com/wynter-yaxley/atrium-desktop" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel>
                            <TextBlock Text="软件更新" Style="{StaticResource SectionStyle}" />
                            <Border Style="{StaticResource TileStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="UpdateStatus" Text="尚未检查" Style="{StaticResource RowTitleStyle}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                        <ProgressRing x:Name="UpdateProgress" Grid.Column="1" Width="18" Height="18"
                                                      IsActive="False" Visibility="Collapsed" VerticalAlignment="Center"
                                                      AutomationProperties.Name="正在检查更新" />
                                        <Button x:Name="CheckUpdateButton" Grid.Column="2" Content="检查更新" MinWidth="104"
                                                VerticalAlignment="Center" Click="OnCheckForUpdates" />
                                    </Grid>
                                    <StackPanel x:Name="ReleaseLinks" Orientation="Horizontal" Spacing="20" Visibility="Collapsed">
                                        <Button x:Name="InstallRelease" Content="下载并安装" Click="OnInstallRelease" Visibility="Collapsed" />
                                        <HyperlinkButton x:Name="ReleaseNotes" Content="发布说明" Padding="0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="设置文件" Style="{StaticResource SectionStyle}" />
                            <Border Style="{StaticResource TileStyle}">
                                <TextBlock x:Name="PathText" Style="{StaticResource RowNoteStyle}" IsTextSelectionEnabled="True" />
                            </Border>
                        </StackPanel>

                        <TextBlock Style="{StaticResource FootnoteStyle}" Margin="4,0,0,0"
                                   Text="界面字体：MiSans，版权归小米科技有限责任公司，依《MiSans 字体知识产权许可协议》使用。" />
                        <HyperlinkButton NavigateUri="https://unsplash.com/@martz90" Content="示例照片：Martin Martz / Unsplash" Padding="4,0" />
                    </StackPanel>

                    <!-- A narrow window: the inspector's groups come here, under the page (OnContentSizeChanged) -->
                    <Border x:Name="FoldedInspector" />
                </StackPanel>
            </ScrollViewer>

            <!-- ======== Inspector ======== -->
            <Grid x:Name="InspectorPane" Grid.Column="1" Width="320">
                <Rectangle Width="1" HorizontalAlignment="Left" Fill="{ThemeResource SeparatorBrush}" />
                <ScrollViewer x:Name="InspectorScroll" Style="{StaticResource PageStyle}" Margin="1,0,0,0">
                    <StackPanel x:Name="InspectorStack" Style="{StaticResource InspectorStackStyle}">
                        <!-- Material: the edge and the light -->
                        <StackPanel x:Name="SideMaterial" Style="{StaticResource InspectorPageStyle}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="边缘" Style="{StaticResource SectionStyle}" />
                                    <Button Style="{StaticResource ResetButtonStyle}" Tag="edge" Click="OnGroupReset" AutomationProperties.Name="恢复边缘的默认值" />
                                </Grid>
                                <StackPanel x:Name="EdgeRows" />
                            </StackPanel>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="光影" Style="{StaticResource SectionStyle}" />
                                    <Button Style="{StaticResource ResetButtonStyle}" Tag="light" Click="OnGroupReset" AutomationProperties.Name="恢复光影的默认值" />
                                </Grid>
                                <StackPanel x:Name="LightRows" />
                            </StackPanel>
                            <Button Content="恢复默认外观" Click="OnDefaults" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Shape: size and width -->
                        <StackPanel x:Name="SideShape" Style="{StaticResource InspectorPageStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="尺寸" Style="{StaticResource SectionStyle}" />
                                    <Button Style="{StaticResource ResetButtonStyle}" Tag="size" Click="OnGroupReset" AutomationProperties.Name="恢复尺寸的默认值" />
                                </Grid>
                                <StackPanel x:Name="SizeRows" />
                            </StackPanel>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="宽度" Style="{StaticResource SectionStyle}" />
                                    <Button Style="{StaticResource ResetButtonStyle}" Tag="width" Click="OnGroupReset" AutomationProperties.Name="恢复宽度的默认值" />
                                </Grid>
                                <StackPanel x:Name="WidthRows">
                                    <local:ToggleTile x:Name="AutoWidthSwitch" Title="自动宽度" SwitchName="自动宽度" Toggled="OnAutoWidthToggled" Flat="True"
                                                      Note="玻璃栏随内容伸缩，像一枚贴合物品的胶囊；关闭后固定为“最大宽度”。" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dock: what the bar shows, the icons, place and motion -->
                        <StackPanel x:Name="SideDock" Style="{StaticResource InspectorPageStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="模块" Style="{StaticResource SectionStyle}" />
                                <local:ToggleTile x:Name="BarSwitch" Title="Atrium 任务栏" SwitchName="Atrium 任务栏" Toggled="OnBarToggled" Flat="True"
                                                  Note="关闭后用回 Windows 自己的任务栏和通知横幅；小组件和台前调度不受影响。" />
                            </StackPanel>
                            <StackPanel x:Name="DockContent">
                                <TextBlock Text="栏上显示" Style="{StaticResource SectionStyle}" />
                                <local:ToggleTile x:Name="TraySwitch" Title="系统托盘" SwitchName="显示系统托盘" Toggled="OnBarContentToggled" Flat="True" />
                                <local:ToggleTile x:Name="StatusSwitch" Title="状态栏" SwitchName="显示状态栏" Toggled="OnBarContentToggled" Flat="True" />
                                <local:ToggleTile x:Name="NotificationsSwitch" Title="通知" SwitchName="显示通知按钮" Toggled="OnBarContentToggled" Flat="True" />
                                <local:ToggleTile x:Name="ClockSwitch" Title="时钟和日期" SwitchName="显示时钟和日期" Toggled="OnClockToggled" Flat="True"
                                                  Note="在栏的右端，使用系统的时间与日期格式。" />
                                <StackPanel x:Name="ClockOptions" Margin="14,-2,0,6" Spacing="2" Visibility="Collapsed">
                                    <local:ToggleTile x:Name="WeekNumberSwitch" Title="显示周数" SwitchName="显示周数" Toggled="OnWeekNumberToggled" Flat="True"
                                                      Note="在时间左侧显示周数。" />
                                    <StackPanel x:Name="WeekRuleOptions" Margin="14,0,0,4" Spacing="6" Visibility="Collapsed">
                                        <TextBlock Text="周数规则" Style="{StaticResource RowTitleStyle}" />
                                        <local:SegmentTrack>
                                            <RadioButton x:Name="WeekRuleIso" GroupName="week-rule" Content="ISO 8601" Tag="iso" Style="{StaticResource SegmentStyle}" Checked="OnWeekRuleChecked" />
                                            <RadioButton x:Name="WeekRuleLocale" GroupName="week-rule" Content="Windows 区域" Tag="locale" Style="{StaticResource SegmentStyle}" Checked="OnWeekRuleChecked" />
                                        </local:SegmentTrack>
                                        <TextBlock Text="ISO：周一开周，含 1 月 4 日的周为第 1 周。Windows 区域：采用系统的周起始日和首周规则。"
                                                   Style="{StaticResource RowNoteStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                                <local:ToggleTile x:Name="RunningSwitch" Title="正在运行的应用" SwitchName="显示正在运行的应用" Toggled="OnRunningToggled" Flat="True"
                                                  Note="固定的应用之后，显示正在运行的其他应用，下方带一个小圆点。" />
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="文字颜色" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                            <RadioButton x:Name="TextAuto" GroupName="ink" Content="自动" Tag="auto" Style="{StaticResource SegmentStyle}" Checked="OnTextColorChecked" />
                                            <RadioButton x:Name="TextLight" GroupName="ink" Content="浅色" Tag="light" Style="{StaticResource SegmentStyle}" Checked="OnTextColorChecked" />
                                            <RadioButton x:Name="TextDark" GroupName="ink" Content="深色" Tag="dark" Style="{StaticResource SegmentStyle}" Checked="OnTextColorChecked" />
                                        </local:SegmentTrack>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="DockLayout">
                                <Grid>
                                    <TextBlock Text="图标与位置" Style="{StaticResource SectionStyle}" />
                                    <Button Style="{StaticResource ResetButtonStyle}" Tag="dock" Click="OnGroupReset" AutomationProperties.Name="恢复图标与位置的默认值" />
                                </Grid>
                                <StackPanel x:Name="DockRows" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Notifications: how long, what they show, where from -->
                        <StackPanel x:Name="SideNotify" Style="{StaticResource InspectorPageStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="弹出" Style="{StaticResource SectionStyle}" />
                                    <Button Style="{StaticResource ResetButtonStyle}" Tag="notify" Click="OnGroupReset" AutomationProperties.Name="恢复弹出的默认值" />
                                </Grid>
                                <StackPanel x:Name="NotifyRows">
                                    <local:ToggleTile x:Name="HideBodySwitch" Title="隐藏通知正文" SwitchName="隐藏通知正文" Toggled="OnHideBodyToggled" Flat="True"
                                                      Note="卡片只显示应用和标题；通知窗口同时不会出现在截图和屏幕共享里。" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="来源" Style="{StaticResource SectionStyle}" />
                                <local:ToggleTile x:Name="ListenerSwitch" Title="Windows 通知" SwitchName="显示 Windows 通知" Toggled="OnListenerToggled" Flat="True"
                                                  Note="QQ 等发出系统通知的应用。需要在 Windows 隐私设置中允许访问通知。" />
                                <local:ToggleTile x:Name="WeChatSwitch" Title="微信" SwitchName="显示微信消息" Toggled="OnWeChatToggled" Flat="True"
                                                  Note="只读微信窗口里的会话列表，有新的未读消息时显示卡片；免打扰的会话不提醒。" />
                                <local:ToggleTile x:Name="FeishuSwitch" Title="飞书" SwitchName="显示飞书消息" Toggled="OnFeishuToggled" Flat="True"
                                                  Note="只读飞书弹窗里的文字，同时显示为卡片；点击卡片打开飞书。" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Stage Manager: on or off, its side; how it is used -->
                        <StackPanel x:Name="SideStage" Style="{StaticResource InspectorPageStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="窗口" Style="{StaticResource SectionStyle}" />
                                <local:ToggleTile x:Name="StageSwitch" Title="台前调度" SwitchName="台前调度" Toggled="OnStageToggled" Flat="True"
                                                  Note="前面的应用留在屏幕中间，其他应用的窗口斜立在屏幕一侧，各带阴影和应用图标。" />
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="最近使用的应用" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                            <RadioButton x:Name="StageLeft" GroupName="stageside" Content="左侧" Tag="left" Style="{StaticResource SegmentStyle}" Checked="OnStageSideChecked" />
                                            <RadioButton x:Name="StageRight" GroupName="stageside" Content="右侧" Tag="right" Style="{StaticResource SegmentStyle}" Checked="OnStageSideChecked" />
                                        </local:SegmentTrack>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="显示方式" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                            <RadioButton x:Name="StageAlways" GroupName="stagemode" Content="常驻" Tag="always" Style="{StaticResource SegmentStyle}" Checked="OnStageModeChecked" />
                                            <RadioButton x:Name="StageAutoHide" GroupName="stagemode" Content="悬停弹出" Tag="hover" Style="{StaticResource SegmentStyle}" Checked="OnStageModeChecked" />
                                        </local:SegmentTrack>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="操作" Style="{StaticResource SectionStyle}" />
                                <StackPanel Style="{StaticResource FlatRowStyle}" Spacing="2">
                                    <TextBlock Text="点按卡片" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="换到前面，原来前面的应用收进一侧。" Style="{StaticResource RowNoteStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FlatRowStyle}" Spacing="2">
                                    <TextBlock Text="Shift + 点按" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="加入当前这一组，之后一起收起、一起回来。" Style="{StaticResource RowNoteStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FlatRowStyle}" Spacing="2">
                                    <TextBlock Text="指针移到屏幕边缘" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="卡片从边缘滑出，浮在窗口上面；指针离开后收回。" Style="{StaticResource RowNoteStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FlatRowStyle}" Spacing="2">
                                    <TextBlock Text="关闭或退出" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="收起的窗口全部恢复。" Style="{StaticResource RowNoteStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Widgets: on or off, what the glass shows -->
                        <StackPanel x:Name="SideWidgets" Style="{StaticResource InspectorPageStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="桌面" Style="{StaticResource SectionStyle}" />
                                <local:ToggleTile x:Name="WidgetsSwitch" Title="桌面小组件" SwitchName="桌面小组件" Toggled="OnWidgetsToggled" Flat="True"
                                                  Note="拖动可移动，拖下角可改变大小，右键可移除。" />
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="靠边排列" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                            <RadioButton x:Name="WidgetsLeft" GroupName="widgetside" Content="左侧" Tag="left" Style="{StaticResource SegmentStyle}" Checked="OnWidgetAlignmentChecked" />
                                            <RadioButton x:Name="WidgetsRight" GroupName="widgetside" Content="右侧" Tag="right" Style="{StaticResource SegmentStyle}" Checked="OnWidgetAlignmentChecked" />
                                        </local:SegmentTrack>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="材质" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                            <RadioButton x:Name="MaterialGlass" GroupName="widgetmaterial" Content="跟随任务栏" Tag="glass" Style="{StaticResource SegmentStyle}" Checked="OnWidgetMaterialChecked" />
                                            <RadioButton x:Name="MaterialDusk" GroupName="widgetmaterial" Content="暮色" Tag="dusk" Style="{StaticResource SegmentStyle}" Checked="OnWidgetMaterialChecked" />
                                            <RadioButton x:Name="MaterialColor" GroupName="widgetmaterial" Content="原色" Tag="color" Style="{StaticResource SegmentStyle}" Checked="OnWidgetMaterialChecked" />
                                        </local:SegmentTrack>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="玻璃映出" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                            <RadioButton x:Name="BackdropDesktop" GroupName="backdrop" Content="实时桌面" Tag="desktop" Style="{StaticResource SegmentStyle}" Checked="OnWidgetBackdropChecked" />
                                            <RadioButton x:Name="BackdropWallpaper" GroupName="backdrop" Content="静态壁纸" Tag="wallpaper" Style="{StaticResource SegmentStyle}" Checked="OnWidgetBackdropChecked" />
                                        </local:SegmentTrack>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Errors: a quiet banner over the workspace's top -->
            <InfoBar x:Name="Status" IsOpen="False" IsClosable="True" MaxWidth="760" Margin="32,12,32,0" VerticalAlignment="Top" />

        </Grid>
    </Grid>
</Window>
